POSTGRES_DB=travellog
POSTGRES_USER=travellog
POSTGRES_PASSWORD=travellog

# Frontend (copy to frontend/.env.local if needed)
VITE_API_BASE_URL=http://localhost:8080

# Backend S3 (export in your shell; do not commit real keys)
# TRAVELLOG_S3_BUCKET=travellog-photos-serena
# TRAVELLOG_S3_REGION=ap-southeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Production / EC2 overrides (examples — set on the server, never commit secrets)
# SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_RDS_ENDPOINT:5432/travellog
# SPRING_DATASOURCE_USERNAME=travellog
# SPRING_DATASOURCE_PASSWORD=
# TRAVELLOG_JWT_SECRET=
# TRAVELLOG_CORS_ALLOWED_ORIGINS=https://YOUR_CLOUDFRONT_DOMAIN
# TRAVELLOG_S3_BUCKET=travellog-photos-serena
# TRAVELLOG_S3_REGION=ap-southeast-2
